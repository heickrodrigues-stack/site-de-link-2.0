            {
                titulo: "HTML Color Codes",
                url: "https://htmlcolorcodes.com/pt/",
                categoria: "Ferramenta",
                descricao: "Paletas de cores, códigos HEX, RGB e seletores para CSS."
            }
        ];

        // Carrega do localStorage ou usa a lista inicial
        let listaSites = JSON.parse(localStorage.getItem('sites_html_css')) || sitesIniciais;

        const grid = document.getElementById('grid-links');
        const form = document.getElementById('form-link');

        function renderizar() {
            grid.innerHTML = '';

            listaSites.forEach(site => {
                const card = document.createElement('a');
                card.href = site.url;
                card.target = '_blank';
                card.className = 'link-card';

                // Classe para estilo da tag
                let tagClass = 'tag-ferramenta';
                if (site.categoria === 'HTML') tagClass = 'tag-html';
                if (site.categoria === 'CSS') tagClass = 'tag-css';

                card.innerHTML = `
                    <div>
                        <div class="link-card-header">
                            <span class="tag-categoria ${tagClass}">${site.categoria}</span>
                            <i class="fa-solid fa-arrow-up-right-from-square" style="font-size:0.8rem; opacity:0.6;"></i>
                        </div>
                        <div class="link-title">${site.titulo}</div>
                        <div class="link-desc">${site.descricao}</div>
                    </div>
                    <div class="link-footer">
                        Acessar site <i class="fa-solid fa-chevron-right"></i>
                    </div>
