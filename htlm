                    <select id="categoria" required>
                        <option value="HTML">HTML</option>
                        <option value="CSS">CSS</option>
                        <option value="Ferramenta">Ferramenta / Utilitário</option>
                    </select>
                    <input type="text" id="descricao" placeholder="Breve descrição do conteúdo" required>
                </div>
                <button type="submit" class="btn-submit">Adicionar à Lista</button>
            </form>
        </section>

        <main>
            <h2 class="section-title"><i class="fa-solid fa-bookmark"></i> Sites Recomendados</h2>
            <div id="grid-links" class="links-grid">
                </div>
        </main>
    </div>

